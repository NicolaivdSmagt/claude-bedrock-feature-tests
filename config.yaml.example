# ABOUTME: Centralized configuration for all standalone test scripts in this directory.
# ABOUTME: Provides AWS region, profile, model IDs, and secrets manager settings.

# Copy this file to config.yaml and fill in your values:
#   cp config.yaml.example config.yaml

# AWS profile for credentials (used by boto3 session)
aws_profile: "default"

# AWS region for Bedrock API calls
region: "us-east-1"

# Bedrock model ID (used by invoke_model / converse API)
# Available IDs include:
#   global.anthropic.claude-opus-4-7
#   us.anthropic.claude-opus-4-7
#   eu.anthropic.claude-opus-4-7
#   global.anthropic.claude-sonnet-4-6
#   global.anthropic.claude-opus-4-6-v1
#   global.anthropic.claude-haiku-4-5-20251001-v1:0
bedrock_model_id: "global.anthropic.claude-sonnet-4-6"

# Bedrock Mantle model ID — bare format, used with AnthropicBedrockMantle client
# (e.g. "anthropic.claude-opus-4-7"). This differs from the CRIS model IDs
# (us.*, eu.*, global.*) used with InvokeModel / Converse on bedrock-runtime.
bedrock_mantle_model_id: "anthropic.claude-opus-4-7"

# Region for the Bedrock Mantle endpoint (Opus 4.7 launches in us-east-1
# and us-west-2 only; eu regions do not serve Opus 4.7 at launch).
mantle_region: "us-east-1"

# Anthropic 1st-party API model ID
anthropic_model_id: "claude-sonnet-4-6"

# AWS Secrets Manager settings for retrieving the Anthropic API key
secrets_manager_region: "us-east-1"
secrets_manager_secret_name: "anthropic_api_key"

# SNS notification settings for the feature scout agent
# Create the topic with: cd agent/infra && terraform apply
sns_topic_arn: ""
sns_region: "us-east-1"
notification_email: ""
