# ABOUTME: Git ignore rules for the claude-bedrock-feature-tests repository.
# ABOUTME: Excludes OS files, Python caches, runtime artifacts, and editor configs.

# OS files
.DS_Store
.DS_Store?
._*
Thumbs.db

# Python
__pycache__/
*.py[cod]
*$py.class
*.so
*.egg-info/
*.egg
dist/
build/
.eggs/

# Virtual environments
.venv/
venv/
ENV/
env/

# IDE / Editor
.idea/
.vscode/
*.swp
*.swo
*~
.project
.settings/

# Runtime artifacts
memories/
reports/
.claude/

# Agent skills: track bedrock-test-writer, ignore claude-api (refreshed from GitHub)
!agent/.claude/
!agent/.claude/skills/
!agent/.claude/skills/bedrock-test-writer/
!agent/.claude/skills/bedrock-test-writer/**
agent/.claude/skills/claude-api/

# Agent runtime artifacts
agent/run_agent.log

# Terraform state and local variables
agent/infra/.terraform/
agent/infra/.terraform.lock.hcl
agent/infra/terraform.tfstate*
agent/infra/terraform.tfvars

# Private config
AGENTS_PRIVATE.md
config.yaml

# Backup files
*.bkp
*.bak
*.orig
