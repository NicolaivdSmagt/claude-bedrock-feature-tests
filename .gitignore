__pycache__/
*.py[cod]
*$py.class
*.so
*.egg-info/
*.egg
dist/
build/
.eggs/

# Virtual environments
.venv/
venv/
ENV/
env/

# IDE / Editor
.idea/
.vscode/
*.swp
*.swo
*~
.project
.settings/

# Runtime artifacts
memories/
reports/
.claude/

# Backup files
*.bkp
*.bak
*.orig
